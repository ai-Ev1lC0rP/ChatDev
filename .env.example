# ============================================================================
# LLM Provider Configuration
# ============================================================================
# BASE_URL and API_KEY authenticate model calls for agent YAML (${BASE_URL} / ${API_KEY}).
# Prefer placeholders in workflows — never hardcode secrets.
#
# Onboarding (recommended):
#   make setup
#   make onboard-models                 # interactive
#   make omniroute-up                   # start OmniRoute (Docker)
#   make omniroute-status
# Non-interactive example:
#   make onboard-models ONBOARD_ARGS='--provider omniroute --api-key YOUR_KEY --yes'

# --- Active model endpoint (updated by make onboard-models) ---
BASE_URL=http://localhost:11434/v1
API_KEY=ollama
DEFAULT_MODEL=gpt-oss:20b
MODEL_PROVIDER=ollama

# --- OmniRoute (recommended multi-provider gateway) ---
# Dashboard: http://localhost:20128  |  API: http://localhost:20128/v1
# Create an API key in Dashboard → Endpoints. Agent model can be: auto
# BASE_URL=http://localhost:20128/v1
# API_KEY=YOUR_OMNIROUTE_API_KEY
# DEFAULT_MODEL=auto
# MODEL_PROVIDER=omniroute

# --- Other OpenAI-compatible presets ---
# OpenAI:
# BASE_URL=https://api.openai.com/v1
# API_KEY=sk-your-openai-api-key-here
# DEFAULT_MODEL=gpt-4o
# MODEL_PROVIDER=openai
#
# Gemini:
# BASE_URL=https://generativelanguage.googleapis.com
# API_KEY=your-gemini-api-key-here
# DEFAULT_MODEL=gemini-2.0-flash
# MODEL_PROVIDER=gemini
#
# LM Studio:
# BASE_URL=http://localhost:1234/v1
# API_KEY=lm-studio
# DEFAULT_MODEL=local-model
# MODEL_PROVIDER=lmstudio
#
# Ollama:
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# DEFAULT_MODEL=gpt-oss:20b
# MODEL_PROVIDER=ollama

# ============================================================================
# Optional: Web Search and Reading Tools
# ============================================================================

# SERPER_DEV_API_KEY=your-serper-api-key-here
# Get from: https://serper.dev

# JINA_API_KEY=your-jina-api-key-here
# Get from: https://jina.ai

# ============================================================================
# Optional: Server / CORS
# ============================================================================
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MAC_AUTO_CLEAN_ATTACHMENTS=0

# ============================================================================
# Optional: Vite HMR (frontend reverse proxy)
# ============================================================================
# Localhost: leave unset (HMR on :5173).
# Behind HTTPS *.casonclark.com (chatdev / chat-dev / bit), set:
# VITE_HMR_CLIENT_PORT=443
# so the browser stays on wss://<public-host>:443 (see frontend/vite.config.js;
# allowedHosts accepts those reverse-proxy Host headers).
